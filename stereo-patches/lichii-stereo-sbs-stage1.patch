diff --git a/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp b/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp
index 41372ed..0935f33 100644
--- a/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp
+++ b/src/video_core/renderer_vulkan/present/window_adapt_pass.cpp
@@ -3,6 +3,7 @@
 
 // SPDX-License-Identifier: GPL-2.0-or-later
 
+#include "common/settings.h"
 #include "core/frontend/framebuffer_layout.h"
 #include "video_core/framebuffer_config.h"
 #include "video_core/host_shaders/vulkan_present_vert_spv.h"
@@ -67,6 +68,10 @@ void WindowAdaptPass::Draw(const Device& device, RasterizerVulkan& rasterizer, S
         layer_it++;
     }
 
+    // Half side-by-side: the whole composition is drawn once per eye into one half of the frame.
+    // Both eyes show the same image until the renderer provides separate per-eye layers.
+    const bool side_by_side = Settings::values.stereo_mode.GetValue() == Settings::StereoMode::SideBySide;
+
     scheduler.Record([=](vk::CommandBuffer cmdbuf) {
         const f32 bg_red = Settings::values.bg_red.GetValue() / 255.0f;
         const f32 bg_green = Settings::values.bg_green.GetValue() / 255.0f;
@@ -92,13 +97,33 @@ void WindowAdaptPass::Draw(const Device& device, RasterizerVulkan& rasterizer, S
         BeginRenderPass(cmdbuf, renderpass, host_framebuffer, render_area);
         cmdbuf.ClearAttachments({clear_attachment}, {clear_rect});
 
-        for (size_t i = 0; i < layer_count; i++) {
-            cmdbuf.BindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS, graphics_pipelines[i]);
-            cmdbuf.PushConstants(graphics_pipeline_layout, VK_SHADER_STAGE_VERTEX_BIT,
-                                 push_constants[i]);
-            cmdbuf.BindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS, graphics_pipeline_layout, 0,
-                                      descriptor_sets[i], {});
-            cmdbuf.Draw(4, 1, 0, 0);
+        const u32 eye_count = side_by_side ? 2 : 1;
+        const u32 eye_width = side_by_side ? render_area.width / 2 : render_area.width;
+        for (u32 eye = 0; eye < eye_count; eye++) {
+            if (side_by_side) {
+                const VkViewport viewport{
+                    .x = static_cast<float>(eye * eye_width),
+                    .y = 0.0f,
+                    .width = static_cast<float>(eye_width),
+                    .height = static_cast<float>(render_area.height),
+                    .minDepth = 0.0f,
+                    .maxDepth = 1.0f,
+                };
+                const VkRect2D scissor{
+                    .offset = {static_cast<s32>(eye * eye_width), 0},
+                    .extent = {eye_width, render_area.height},
+                };
+                cmdbuf.SetViewport(0, viewport);
+                cmdbuf.SetScissor(0, scissor);
+            }
+            for (size_t i = 0; i < layer_count; i++) {
+                cmdbuf.BindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS, graphics_pipelines[i]);
+                cmdbuf.PushConstants(graphics_pipeline_layout, VK_SHADER_STAGE_VERTEX_BIT,
+                                     push_constants[i]);
+                cmdbuf.BindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                          graphics_pipeline_layout, 0, descriptor_sets[i], {});
+                cmdbuf.Draw(4, 1, 0, 0);
+            }
         }
 
         cmdbuf.EndRenderPass();
