+/// Shifts the clip-space x of a stereo draw by the eye's parallax: zero at w == convergence,
+/// growing with distance, opposite sign per eye (ViewIndex 0 is the left eye). Positions with
+/// w <= 1 come from orthographic projections (HUD, full-screen passes) and stay at the screen.
+void ApplyStereoOffset(EmitContext& ctx) {
+    const Id type{ctx.F32[1]};
+    const Id position{ctx.OpLoad(ctx.F32[4], ctx.output_position)};
+    const Id x{ctx.OpCompositeExtract(type, position, 0u)};
+    const Id w{ctx.OpCompositeExtract(type, position, 3u)};
+    const Id view{ctx.OpLoad(ctx.U32[1], ctx.view_index)};
+    const Id right_eye{ctx.OpINotEqual(ctx.U1, view, ctx.u32_zero_value)};
+    const Id eye{
+        ctx.OpSelect(type, right_eye, ctx.Constant(type, 1.0f), ctx.Constant(type, -1.0f))};
+    const Id convergence{ctx.Constant(type, ctx.runtime_info.stereo_convergence)};
+    const Id separation{ctx.Constant(type, ctx.runtime_info.stereo_separation)};
+    const Id parallax{ctx.OpFMul(type, ctx.OpFSub(type, w, convergence), separation)};
+    const Id shifted{ctx.OpFAdd(type, x, ctx.OpFMul(type, eye, parallax))};
+    const Id perspective{ctx.OpFOrdGreaterThan(ctx.U1, w, ctx.Constant(type, 1.0001f))};
+    const Id result{ctx.OpSelect(type, perspective, shifted, x)};
+    ctx.OpStore(ctx.output_position, ctx.OpCompositeInsert(ctx.F32[4], result, position, 0u));
+}
