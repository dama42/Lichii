+/// A pipeline built for a two-view render pass can only draw into a two-view framebuffer and the
+/// reverse. They differ when a render target is not a plain image with a right eye layer; that
+/// draw is skipped.
+bool StereoFramebufferMatches(const FixedPipelineState& state, const Framebuffer* framebuffer) {
+    if ((state.stereo != 0) == framebuffer->IsStereo()) {
+        return true;
+    }
+    static std::atomic<u32> reports{0};
+    if (reports.fetch_add(1) < 8) {
+        LOG_WARNING(Render_Vulkan,
+                    "Skipping a draw: its stereo state ({}) differs from its framebuffer's ({})",
+                    state.stereo != 0, framebuffer->IsStereo());
+    }
+    return false;
+}
