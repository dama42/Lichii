+/// True when every bound render target is a plain single-layer 2D image, the only kind that gets
+/// a second (right eye) layer. Mirrors how the texture cache derives those images' types.
+bool StereoRenderTargets(const Maxwell& regs) {
+    bool any = false;
+    for (u32 index = 0; index < regs.rt_control.count && index < Maxwell::NumRenderTargets;
+         ++index) {
+        const auto& rt = regs.rt[index];
+        if (rt.Address() == 0 || rt.format == Tegra::RenderTargetFormat::NONE) {
+            continue;
+        }
+        if (rt.tile_mode.is_pitch_linear != 0 ||
+            rt.tile_mode.dim_control == Maxwell::TileMode::DimensionControl::DefineDepthSize ||
+            rt.depth.Value() != 1) {
+            return false;
+        }
+        any = true;
+    }
+    if (regs.zeta_enable != 0 && regs.zeta.Address() != 0) {
+        const auto& zeta = regs.zeta;
+        const u32 layers = regs.zeta_size.dim_control ==
+                                   Maxwell::ZetaSize::DimensionControl::DefineArraySize
+                               ? regs.zeta_size.depth.Value()
+                               : 1;
+        if (zeta.tile_mode.is_pitch_linear != 0 ||
+            zeta.tile_mode.dim_control == Maxwell::TileMode::DimensionControl::DefineDepthSize ||
+            layers != 1) {
+            return false;
+        }
+        any = true;
+    }
+    return any;
+}
