@@ -41,7 +41,14 @@ void ApplyStereoOffset(EmitContext& ctx) {
     const Id parallax{ctx.OpFMul(type, ctx.OpFSub(type, w, convergence), separation)};
     const Id shifted{ctx.OpFAdd(type, x, ctx.OpFMul(type, eye, parallax))};
     const Id perspective{ctx.OpFOrdGreaterThan(ctx.U1, w, ctx.Constant(type, 1.0001f))};
-    const Id result{ctx.OpSelect(type, perspective, shifted, x)};
+    Id flat{x};
+    if (ctx.runtime_info.stereo_hud_popout != 0.0f) {
+        // Flat draws move opposite to the parallax sign, i.e. in front of the screen.
+        const Id popout{ctx.Constant(type, ctx.runtime_info.stereo_hud_popout)};
+        const Id offset{ctx.OpFMul(type, ctx.OpFMul(type, eye, popout), w)};
+        flat = ctx.OpFSub(type, x, offset);
+    }
+    const Id result{ctx.OpSelect(type, perspective, shifted, flat)};
     ctx.OpStore(ctx.output_position, ctx.OpCompositeInsert(ctx.F32[4], result, position, 0u));
 }
 
