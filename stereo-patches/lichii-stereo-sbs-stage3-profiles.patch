 }
 
+/// Shift (clip x per unit w) of flat HUD draws, 0 when disabled.
+[[nodiscard]] inline f32 HudPopout() {
+    return Detail::hud_popout.load(std::memory_order_relaxed);
+}
+
 } // namespace VideoCore::Stereo
diff --git a/src/video_core/stereo_profiles.h b/src/video_core/stereo_profiles.h
new file mode 100644
index 0000000..a91427b
--- /dev/null
+++ b/src/video_core/stereo_profiles.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <optional>
+
+#include "common/common_types.h"
+
+namespace VideoCore::Stereo {
+
+/// Per-game tuning taken from the Ryujinx Stereo fork's profiles. That fork applies the same
+/// parallax as Lichii (clip x += eye * separation * (w - convergence)), so the numbers carry over.
+/// Only the numbers are used; the fork's OpenGL-specific shader rewrites are not part of this.
+struct GameProfile {
+    u64 title_id; ///< Base title id (low 13 bits cleared).
+    f32 separation;
+    f32 convergence;
+    f32 hud_popout_percent; ///< Shift of flat (HUD) draws, in percent of the half width.
+};
+
+inline constexpr std::array<GameProfile, 13> GAME_PROFILES{{
+    {0x0100000000010000, 0.016256448f, 1900.0f, 1.2f},  // Super Mario Odyssey
+    {0x010015100b514000, 0.00168f, 625.0f, 0.0f},       // Super Mario Bros. Wonder
+    {0x0100152000022000, 0.00744f, 300.0f, 0.8f},       // Mario Kart 8 Deluxe
+    {0x010028600ebda000, 0.012f, 2250.0f, 2.0f},        // Super Mario 3D World + Bowser's Fury
+    {0x01004d300c5ae000, 0.00672f, 50.0f, 0.5f},        // Kirby and the Forgotten Land
+    {0x01006a800016e000, 0.01848f, 200.0f, 2.0f},       // (title id only, from the fork)
+    {0x01006bb00c6f0000, 0.003893984f, 125.0f, 4.0f},   // The Legend of Zelda: Link's Awakening
+    {0x01007ef00011e000, 0.0113568f, 12.0f, 0.0f},      // The Legend of Zelda: Breath of the Wild
+    {0x010093801237c000, 0.005014891f, 3000.0f, 0.3f},  // Metroid Dread
+    {0x01009bf0072d4000, 0.0156f, 2800.0f, 0.0f},       // (title id only, from the fork)
+    {0x0100c1f0051b6000, 0.00072f, 425.0f, 2.0f},       // (title id only, from the fork)
+    {0x0100ea80032ea000, 0.024f, 1800.0f, 0.5f},        // (title id only, from the fork)
+    {0x0100f2c0115b6000, 0.01070784f, 12.0f, 2.0f},     // The Legend of Zelda: Tears of the Kingdom
+}};
+
+[[nodiscard]] constexpr std::optional<GameProfile> FindGameProfile(u64 program_id) {
+    const u64 base = program_id & ~u64{0x1FFF};
+    for (const GameProfile& profile : GAME_PROFILES) {
+        if (profile.title_id == base) {
+            return profile;
+        }
+    }
+    return std::nullopt;
+}
+
+} // namespace VideoCore::Stereo
