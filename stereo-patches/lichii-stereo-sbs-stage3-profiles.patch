 namespace VideoCore::Stereo {
 
 namespace Detail {
+inline std::atomic<bool> supported{false};
+inline std::atomic<bool> wanted{false};
 inline std::atomic<bool> active{false};
 inline std::atomic<f32> separation{0.0f};
 inline std::atomic<f32> convergence{1.0f};
+inline std::atomic<f32> hud_popout{0.0f};
+// Without a game profile: x shift per unit of (w - convergence) at depth 100%, and the
+// convergence distance at the middle of the convergence slider.
+constexpr f32 DEFAULT_SEPARATION = 0.03f;
+constexpr f32 DEFAULT_CONVERGENCE = 15.811388f; // 0.5 * 1000^0.5
+inline std::atomic<f32> base_separation{DEFAULT_SEPARATION};
+inline std::atomic<f32> base_convergence{DEFAULT_CONVERGENCE};
+inline std::atomic<f32> base_hud_popout{0.0f};
+
+inline void Recompute() {
+    const f32 depth = static_cast<f32>(Settings::values.stereo_depth.GetValue()) / 100.0f;
+    // The slider at 50 keeps the base convergence; every 100 steps scale it by 1000.
+    const f32 slider =
+        static_cast<f32>(Settings::values.stereo_convergence.GetValue() - 50) / 100.0f;
+    separation.store(base_separation.load() * depth);
+    convergence.store(base_convergence.load() * std::pow(1000.0f, slider));
+    hud_popout.store(Settings::values.stereo_hud_popout.GetValue() ? base_hud_popout.load()
+                                                                   : 0.0f);
+    active.store(wanted.load() && supported.load());
+}
 } // namespace Detail
 
 /// Reads the stereo settings once, when the renderer starts. Every render pass, image and shader
 /// built afterwards uses this snapshot, so changing the settings needs a restart of the game.
 inline void Latch(bool multiview_supported) {
-    const bool wanted = Settings::values.stereo_mode.GetValue() == Settings::StereoMode::SideBySide &&
-                        Settings::values.stereo_geometric.GetValue();
-    const f32 depth = static_cast<f32>(Settings::values.stereo_depth.GetValue()) / 100.0f;
-    const f32 convergence = static_cast<f32>(Settings::values.stereo_convergence.GetValue()) / 100.0f;
-    // Clip-space x shift per unit of (w - convergence): 3% of the half-width at depth 100%.
-    Detail::separation.store(0.03f * depth);
-    // Distance (in clip-space w) of the plane that has no parallax: 0.5 to 500.
-    Detail::convergence.store(0.5f * std::pow(1000.0f, convergence));
-    Detail::active.store(wanted && multiview_supported);
+    Detail::wanted.store(Settings::values.stereo_mode.GetValue() ==
+                             Settings::StereoMode::SideBySide &&
+                         Settings::values.stereo_geometric.GetValue());
+    Detail::supported.store(multiview_supported);
+    Detail::base_separation.store(Detail::DEFAULT_SEPARATION);
+    Detail::base_convergence.store(Detail::DEFAULT_CONVERGENCE);
+    Detail::base_hud_popout.store(0.0f);
+    Detail::Recompute();
+}
+
+/// Called when a GPU channel starts for a program. A game with a built-in profile replaces the
+/// generic separation and convergence; the depth and convergence sliders then adjust the profile.
+inline void SelectProfile(u64 program_id) {
+    if (!Detail::wanted.load() || !Settings::values.stereo_use_profiles.GetValue()) {
+        return;
+    }
+    const auto profile = FindGameProfile(program_id);
+    if (!profile) {
+        return;
+    }
+    Detail::base_separation.store(profile->separation);
+    Detail::base_convergence.store(profile->convergence);
+    Detail::base_hud_popout.store((std::min)(profile->hud_popout_percent, 5.0f) / 100.0f);
+    Detail::Recompute();
+    LOG_INFO(Render_Vulkan, "Stereo profile for {:016X}: separation={}, convergence={}",
+             program_id, profile->separation, profile->convergence);
 }
 
