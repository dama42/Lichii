diff --git a/src/video_core/stereo_rules.h b/src/video_core/stereo_rules.h
new file mode 100644
index 0000000..1a4fdce
--- /dev/null
+++ b/src/video_core/stereo_rules.h
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+
+#include "common/common_types.h"
+#include "common/fs/path_util.h"
+#include "common/logging.h"
+#include "common/settings.h"
+
+namespace VideoCore::Stereo {
+
+/// What to do with the draws of one shader, chosen in `stereo_rules.txt` (config directory).
+struct ShaderRule {
+    enum class Kind { Default, Skip, Scale, Hud };
+    Kind kind{Kind::Default};
+    float value{1.0f}; ///< Scale factor, or HUD pop-out in percent.
+};
+
+namespace Detail {
+inline std::mutex rules_mutex;
+inline bool rules_loaded = false;
+inline std::unordered_map<u64, ShaderRule> rules;
+inline std::set<u64> logged;
+
+inline void LoadRules() {
+    rules_loaded = true;
+    const auto path = Common::FS::GetEdenPath(Common::FS::EdenPath::ConfigDir) / "stereo_rules.txt";
+    std::ifstream file{path};
+    if (!file) {
+        return;
+    }
+    std::string line;
+    while (std::getline(file, line)) {
+        if (const auto hash_comment = line.find('#'); hash_comment != std::string::npos) {
+            line.resize(hash_comment);
+        }
+        std::istringstream words{line};
+        std::string hash_text;
+        std::string kind;
+        if (!(words >> hash_text >> kind)) {
+            continue;
+        }
+        u64 hash{};
+        try {
+            hash = std::stoull(hash_text, nullptr, 16);
+        } catch (...) {
+            continue;
+        }
+        ShaderRule rule;
+        float value{};
+        if (kind == "skip") {
+            rule.kind = ShaderRule::Kind::Skip;
+        } else if (kind == "scale" && (words >> value)) {
+            rule.kind = ShaderRule::Kind::Scale;
+            rule.value = value;
+        } else if (kind == "hud") {
+            rule.kind = ShaderRule::Kind::Hud;
+            rule.value = (words >> value) ? value : 1.0f;
+        } else {
+            LOG_WARNING(Render_Vulkan, "stereo_rules.txt: ignoring '{}'", line);
+            continue;
+        }
+        rules[hash] = rule;
+    }
+    LOG_INFO(Render_Vulkan, "Stereo rules: {} loaded from {}", rules.size(), path.string());
+}
+} // namespace Detail
+
+/// Looks up the rule for a draw by its vertex or fragment shader hash (vertex first).
+[[nodiscard]] inline ShaderRule FindRule(u64 vertex_hash, u64 fragment_hash) {
+    std::scoped_lock lock{Detail::rules_mutex};
+    if (!Detail::rules_loaded) {
+        Detail::LoadRules();
+    }
+    for (const u64 hash : {vertex_hash, fragment_hash}) {
+        if (const auto it = Detail::rules.find(hash); it != Detail::rules.end()) {
+            return it->second;
+        }
+    }
+    return {};
+}
+
+/// With "Log stereo shaders" on, writes each shader pair once so it can be named in the rules.
+inline void LogShader(u64 vertex_hash, u64 fragment_hash, const ShaderRule& rule) {
+    if (!Settings::values.stereo_debug_log.GetValue()) {
+        return;
+    }
+    std::scoped_lock lock{Detail::rules_mutex};
+    if (!Detail::logged.insert(vertex_hash ^ (fragment_hash * 0x9E3779B97F4A7C15ULL)).second) {
+        return;
+    }
+    LOG_INFO(Render_Vulkan, "Stereo shader: vertex={:016x} fragment={:016x} rule={}", vertex_hash,
+             fragment_hash,
+             rule.kind == ShaderRule::Kind::Default ? "default"
+             : rule.kind == ShaderRule::Kind::Skip  ? "skip"
+             : rule.kind == ShaderRule::Kind::Scale ? "scale"
+                                                    : "hud");
+}
+
+} // namespace VideoCore::Stereo
